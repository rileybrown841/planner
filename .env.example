# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Set the same vars in Vercel too.
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# "API Keys" → publishable key (starts with sb_publishable_...).
# Safe to expose to the browser; Row Level Security is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The one email address allowed to sign in. Must match the user you create
# in Supabase → Authentication → Users. Any other identity is rejected.
ALLOWED_EMAIL=

# Absolute URL of the deployed app, e.g. https://planner.yourdomain.com
# Used to build the magic-link redirect. Leave blank for local dev
# (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=
